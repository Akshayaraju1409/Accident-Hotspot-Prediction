{
  "project": "RoadWatch V4 Severity V2",
  "primary_task": "Binary severe-vs-non-severe classification among observed crash records",
  "severe_definition": {
    "positive": [
      "1 Fatal",
      "2 Grievous injury"
    ],
    "negative": [
      "3 Minor injury",
      "4 No injury"
    ]
  },
  "not_a_crash_occurrence_model": true,
  "split_method": "Chronological train/validation/test; model and threshold selected on validation only; final test held out.",
  "split_boundaries": {
    "train_before": "2017-01-01",
    "validation_from": "2017-01-01",
    "validation_before": "2018-12-02",
    "test_from": "2018-12-02"
  },
  "split": {
    "training": {
      "rows": 669,
      "start": "2013-01-09",
      "end": "2016-12-12"
    },
    "validation": {
      "rows": 573,
      "start": "2017-01-01",
      "end": "2018-12-01"
    },
    "test": {
      "rows": 362,
      "start": "2018-12-04",
      "end": "2023-12-07"
    }
  },
  "features": [
    "Accident_Location_A",
    "Accident_Location_A_Chainage_km_RoadSide",
